# Runtime
ENV=dev
PORT=8080
LOG_LEVEL=INFO

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
VERTEX_MODEL=gemini-1.5-pro

# Auth mode
# Prefer ADC (service account) in Cloud Run.
# For local tests only, you can set GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional direct key mode (only if needed)
GOOGLE_API_KEY=

# Data brain
BRAND_PROFILE_PATH=data/brand/brand_profile.example.yaml
CONTENT_HISTORY_PATH=data/brand/content_history.example.md

# Optional integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=contato@2e.ia.br
WEBHOOK_URL=

# Persistence toggles
USE_FIRESTORE=false
USE_GCS=false
FIRESTORE_COLLECTION=sessions
GCS_BUCKET=
